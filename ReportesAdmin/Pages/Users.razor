@page "/users"
@page "/usuarios"
@layout MainLayout

@inject HttpClient Http
@inject AuthService Auth

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color:#042a80;">Usuarios</h2>
        <button class="btn btn-primary" @onclick="ShowAddUserModal">Agregar usuario</button>
    </div>

    <!-- Lista de usuarios -->
    <div>
        @if (users == null)
        {
            <p>Cargando usuarios...</p>
        }
        else if (!users.Any())
        {
            <p>No hay usuarios registrados.</p> 
        }
        else
        {
            <ul class="list-group">
                @foreach (var user in PagedUsers)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@user.Name @user.LastName (@user.Role)</span>
                        <div class="dropdown">
                            <button class="btn btn-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" @onclick="() => ShowEditUserModal(user)">Editar</a></li>
                                <li><a class="dropdown-item text-danger" @onclick="() => ShowDeleteUserModal(user)">Eliminar</a></li>
                            </ul>
                        </div>
                    </li>
                }
            </ul>

            <!-- Paginación -->
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageIndex = i;
                        <li class="page-item @(i == CurrentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Modal Crear/Editar -->
@if (showUserModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((editingUser != null) ? "Editar usuario" : "Agregar usuario")</h5>
                    <button type="button" class="btn-close" @onclick="CloseUserModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <input class="form-control" @bind="formUser.Username" placeholder="Username" />
                    </div>
                    <div class="mb-3">
                        <input class="form-control" @bind="formUser.PasswordHash" type="password" placeholder="Contraseña" />
                    </div>
                    <div class="mb-3">
                        <input class="form-control" @bind="formUser.Name" placeholder="Nombre" />
                    </div>
                    <div class="mb-3">
                        <input class="form-control" @bind="formUser.LastName" placeholder="Apellido" />
                    </div>
                    <div class="mb-3">
                        <select class="form-select" @bind="formUser.Role">
                            <option value="Admin">Admin</option>
                            <option value="Supervisor">Supervisor</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <select class="form-select" @bind="formUser.Position" >
                            <option value="Asesor Telefónico">Asesor Telefónico</option>
                            <option value="Analista">Analista</option>
                            <option value="Contaduria">Contaduría</option>
                            <option value="Disenador">Diseñador</option>
                            <option value="Gerente">Gerente</option>
                            <option value="Mercadotecnia">Mercadotecnia</option>
                            <option value="Lider de Proyecto">Lider de Proyecto</option>
                            <option value="Programador">Programador</option>
                            <option value="Soporte Técnico">Soporte Técnico</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="Tester">Tester</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <input class="form-control" @bind="formUser.BirthDate" type="date"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseUserModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveUser" disabled="@IsCreateDisabled">
                        @((editingUser != null) ? "Guardar cambios" : "Crear usuario")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Modal Eliminar -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar usuario</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro que quieres eliminar el usuario <strong>@deleteUser?.Name @deleteUser?.LastName</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<UserWithPassDto>? users;
    private List<UserWithPassDto> PagedUsers => users!
        .OrderBy(u => u.Name + u.LastName)
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)(users?.Count ?? 0) / PageSize);

    private bool showUserModal = false;
    private bool showDeleteModal = false;
    private UserWithPassDto? editingUser;
    private UserWithPassDto? deleteUser;
    private UserWithPassDto formUser = new();
    private bool IsCreateDisabled =>
    editingUser == null &&
    (string.IsNullOrWhiteSpace(formUser.Username) ||
     string.IsNullOrWhiteSpace(formUser.PasswordHash) ||
     string.IsNullOrWhiteSpace(formUser.Name) ||
     string.IsNullOrWhiteSpace(formUser.LastName) ||
     string.IsNullOrWhiteSpace(formUser.Role) ||
     string.IsNullOrWhiteSpace(formUser.Position));


    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        var request = new HttpRequestMessage(HttpMethod.Get, "/api/Users");
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            users = await response.Content.ReadFromJsonAsync<List<UserWithPassDto>>();
        }
    }

    private void ShowAddUserModal()
    {
        formUser = new UserWithPassDto();
        editingUser = null;
        showUserModal = true;
    }

    private void ShowEditUserModal(UserWithPassDto user)
    {
        editingUser = user;
        formUser = new UserWithPassDto
        {
            Username = user.Username,
            Name = user.Name,
            LastName = user.LastName,
            Position = user.Position,
            Role = user.Role,
            BirthDate = user.BirthDate
        };
        showUserModal = true;
    }

    private void CloseUserModal() => showUserModal = false;

    private async Task SaveUser()
    {
        if (editingUser == null)
        {
            // Validación: todos los campos obligatorios deben estar llenos
            if (string.IsNullOrWhiteSpace(formUser.Username) ||
                string.IsNullOrWhiteSpace(formUser.PasswordHash) ||
                string.IsNullOrWhiteSpace(formUser.Name) ||
                string.IsNullOrWhiteSpace(formUser.LastName) ||
                string.IsNullOrWhiteSpace(formUser.Role) ||
                string.IsNullOrWhiteSpace(formUser.Position))
            {
                // No hace nada si hay campos vacíos
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Post, "/api/Users")
            {
                Content = JsonContent.Create(formUser)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            await Http.SendAsync(request);
        }
        else
        {
            // En edición no validamos campos vacíos
            var request = new HttpRequestMessage(HttpMethod.Put, $"/api/Users/{editingUser.Id}")
            {
                Content = JsonContent.Create(formUser)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            await Http.SendAsync(request);
        }

        showUserModal = false;
        await LoadUsers();
    }

    private void ShowDeleteUserModal(UserWithPassDto user)
    {
        deleteUser = user;
        showDeleteModal = true;
    }

    private void CloseDeleteModal() => showDeleteModal = false;

    private async Task ConfirmDelete()
    {
        var request = new HttpRequestMessage(HttpMethod.Delete, $"/api/Users/{deleteUser!.Id}");
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

        await Http.SendAsync(request);
        showDeleteModal = false;
        await LoadUsers();
    }

    private void ChangePage(int page)
    {
        CurrentPage = page;
        Console.WriteLine($"Cambiando a página {page}");
        StateHasChanged();
    }

}